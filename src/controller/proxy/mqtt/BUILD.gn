import("//build_overrides/chip.gni")
import("${chip_root}/src/controller/proxy/mqtt/mqtt.gni")

assert(
    chip_enable_mqtt_transport,
    "This BUILD.gn must only be referenced when chip_enable_mqtt_transport=true")

source_set("mqtt") {
  sources = [
    "IpcProtocol.h",
    "MqttIpcClient.cpp",
    "MqttIpcClient.h",
    "MqttTransportAdapter.cpp",
    "MqttTransportAdapter.h",
  ]

  public_deps = [
    "${chip_root}/src/controller/proxy",
    "${chip_root}/src/lib/core",
    "${chip_root}/src/lib/support",
    "${chip_root}/src/platform",
    "${chip_root}/src/system",
  ]

  cflags = [ "-Wconversion" ]
}
